{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": [
    "VITEST_MAX_WORKERS",
    "VITEST_MAX_FORKS",
    "VITEST_MAX_THREADS",
    "VITEST_MIN_FORKS",
    "VITEST_MIN_THREADS"
  ],
  "globalDependencies": [
    "external/feedbackops/packages/ui/**",
    "external/feedbackops/packages/shared/**",
    "!external/feedbackops/packages/*/.turbo/**",
    "!external/feedbackops/packages/*/dist/**",
    "!external/feedbackops/packages/*/coverage/**",
    "!external/feedbackops/packages/*/**/*.tsbuildinfo"
  ],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    }
  }
}
