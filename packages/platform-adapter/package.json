{
  "name": "@eqv/platform-adapter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest-entry.ts",
    "./styles.css": "./src/styles.css",
    "./mock-data": "./src/mock-data/index.ts"
  },
  "scripts": {
    "gen:mock-data": "node scripts/gen-mock-data.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node ../../tooling/scripts/eqv-finalize-dist.mjs",
    "test": "vitest run --config vitest.config.ts"
  },
  "peerDependencies": {
    "@ap/contracts": "0.15.0",
    "@ap/ui": "0.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@eqv/core": "workspace:*",
    "@eqv/renderer": "workspace:*",
    "@eqv/replay": "workspace:*",
    "@eqv/ui": "workspace:*",
    "@eqv/views": "workspace:*",
    "lucide-react": "0.469.0"
  },
  "devDependencies": {
    "@ap/contracts": "https://github.com/hjung3113/analytics-platform/releases/download/sdk-v0.15.0/ap-contracts-0.15.0.tgz",
    "@ap/ui": "https://github.com/hjung3113/analytics-platform/releases/download/sdk-v0.15.0/ap-ui-0.15.0.tgz",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
