{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.4"
    },
    "equipmentId": {
      "type": "string",
      "minLength": 1
    },
    "layoutId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "alias": {
            "type": "string"
          },
          "target": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "ignore": {
                    "type": "boolean",
                    "const": true
                  }
                },
                "required": [
                  "ignore"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "componentId": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                  },
                  "slots": {
                    "type": "object",
                    "properties": {
                      "offset": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "assign": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "from": {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            },
                            "to": {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            },
                            "holdingSiteId": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                            }
                          },
                          "required": [
                            "from",
                            "to",
                            "holdingSiteId"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "offset",
                      "assign"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "componentId"
                ],
                "additionalProperties": false
              }
            ]
          },
          "certainty": {
            "type": "string",
            "enum": [
              "verified",
              "assumed"
            ]
          },
          "rule": {
            "type": "object",
            "properties": {
              "scope": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "level": {
                        "type": "string",
                        "const": "global"
                      }
                    },
                    "required": [
                      "level"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "level": {
                        "type": "string",
                        "const": "maker"
                      },
                      "maker": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "level",
                      "maker"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "level": {
                        "type": "string",
                        "const": "model"
                      },
                      "maker": {
                        "type": "string",
                        "minLength": 1
                      },
                      "model": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "level",
                      "maker",
                      "model"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "level": {
                        "type": "string",
                        "const": "equipment"
                      },
                      "equipmentId": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "level",
                      "equipmentId"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "ruleId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              }
            },
            "required": [
              "scope",
              "ruleId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "alias",
          "target",
          "certainty",
          "rule"
        ],
        "additionalProperties": false
      }
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "equipmentId",
    "layoutId",
    "entries",
    "hash"
  ],
  "additionalProperties": false
}
