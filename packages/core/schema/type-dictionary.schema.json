{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.4"
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "level": {
              "type": "string",
              "const": "global"
            }
          },
          "required": [
            "level"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "level": {
              "type": "string",
              "const": "maker"
            },
            "maker": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "level",
            "maker"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "level": {
              "type": "string",
              "const": "model"
            },
            "maker": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "level",
            "maker",
            "model"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "level": {
              "type": "string",
              "const": "equipment"
            },
            "equipmentId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "level",
            "equipmentId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "moduleType": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "moduleType",
          "role"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "scope",
    "entries"
  ],
  "additionalProperties": false
}
